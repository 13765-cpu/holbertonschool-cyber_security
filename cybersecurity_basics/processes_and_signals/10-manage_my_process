#!/usr/bin/env bash
# Init-style script to manage manage_my_process

PID_FILE=/tmp/my_process.pid
PROCESS_SCRIPT=./manage_my_process

case "$1" in
  start)
    $PROCESS_SCRIPT &        # background-da işə sal
    echo $! > "$PID_FILE"    # PID yaz
    echo "manage_my_process started"
    ;;
  stop)
    if [[ -f "$PID_FILE" ]]; then
      kill "$(cat $PID_FILE)" 2>/dev/null
      rm -f "$PID_FILE"
      echo "manage_my_process stopped"
    else
      echo "manage_my_process not running"
    fi
    ;;
  restart)
    if [[ -f "$PID_FILE" ]]; then
      kill "$(cat $PID_FILE)" 2>/dev/null
      rm -f "$PID_FILE"
    fi
    $PROCESS_SCRIPT &          # background-da işə sal
    echo $! > "$PID_FILE"
    echo "manage_my_process restarted"
    ;;
  *)
    echo "Usage: manage_my_process {start|stop|restart}"
    ;;
esac
